# Copy to .env; paste credentials there, never in source control or chat.
# Runtime uses the pooled connection; migrations use the direct connection.
# Both URLs must refer to the SAME Neon branch and database.
PORTAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=verify-full
PORTAL_MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full
